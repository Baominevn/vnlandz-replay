{
  "version": 2,
  "rewrites": [
    { "source": "/admin/data", "destination": "/server.js" },
    { "source": "/login", "destination": "/server.js" },
    { "source": "/logout", "destination": "/server.js" },
    { "source": "/((?!api|_next|index\\.html|style\\.css|script\\.js).*)*", "destination": "/server.js" }
  ]
}