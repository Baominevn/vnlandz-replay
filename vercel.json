{
  "version": 2,
  "builds": [
    { "src": "server.js", "use": "@vercel/node" }
  ],
  "routes": [
    { "src": "/admin/data", "dest": "server.js" },
    { "src": "/login", "dest": "server.js" },
    { "src": "/logout", "dest": "server.js" },
    { "src": "/(.*\\.(css|js|html))", "dest": "/$1" },
    { "src": "/(.*)", "dest": "server.js" }
  ]
}